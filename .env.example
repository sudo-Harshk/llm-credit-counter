# ============================================================
#  LLMCREDITCOUNT — Environment Variables
#  Copy this file to backend/.env and fill in your real values.
# ============================================================


# ────────────────────────────────────────────────────────────
#  FLASK
# ────────────────────────────────────────────────────────────

# Set to "true" only during local development.
# Always leave as "false" (or unset) in production.
FLASK_DEBUG=false


# ────────────────────────────────────────────────────────────
#  LLM PROVIDER API KEYS
# ────────────────────────────────────────────────────────────

# OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=


# ────────────────────────────────────────────────────────────
#  ADDING A NEW PROVIDER?
#  1. Add its API key here with a clear comment and link.
#  2. Add a fetch_<provider>_balance() function in backend/server.py.
#  3. Register it in the PROVIDERS list in backend/server.py.
# ────────────────────────────────────────────────────────────
